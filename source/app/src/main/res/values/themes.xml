<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AppCompat.FullScreen" parent="@style/Theme.AppCompat">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <!-- Deterministic opaque clear while SDL/GL4ES creates its surface. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Compact dark button used by the touch-layout editor, so the editor
         chrome does not cover the controls it is arranging. -->
    <style name="EditorButton" parent="android:Widget.Button">
        <item name="android:background">@drawable/editor_button</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textColor">#FFF2F4F6</item>
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

</resources>